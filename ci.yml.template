name: 'PHP {{ php_minor }}'

on:
  pull_request:
    paths:
      - {{ php_minor }}/**
  push:
    branches:
      - master
    paths:
      - {{ php_minor }}/**

defaults:
  run:
    shell: 'bash -Eeuo pipefail -x {0}'

permissions:
  contents: read

# Queue rather than overlap, so an older run can never repoint tags after a newer one
concurrency:
  group: ${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: false

env:
  GHCR_REPO: ghcr.io/${{ github.repository_owner }}/php
  DOCKER_HUB_REPO: docker.io/sunasteriskrnd/php

jobs:
  verify-templating:
    name: Verify templating
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v5
      - name: Generate
        run: make all
      - name: Check Git status
        run: |
          test -z "$(git status --short)"

  build:
    name: ${{ matrix.target }} (${{ matrix.platform }})
    runs-on: ${{ matrix.runner }}
    timeout-minutes: 340
    needs:
      - verify-templating
    permissions:
      contents: read
      packages: write
    strategy:
      fail-fast: false
      matrix:
        target:
          {{ targets }}
        platform:
          {{ platforms }}
        include:
          - platform: linux/amd64
            runner: ubuntu-latest
          - platform: linux/arm64
            runner: ubuntu-24.04-arm
          # No GitHub runner executes armv7 natively, so it is emulated on the arm64 runner
          - platform: linux/arm
            runner: ubuntu-24.04-arm
    env:
      PUSH: ${{ github.event_name == 'push' && github.ref == 'refs/heads/master' }}
      TARGET: ${{ matrix.target }}
      PLATFORM: ${{ matrix.platform }}
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Set up QEMU
        uses: docker/setup-qemu-action@v3
        with:
          platforms: ${{ matrix.platform }}
      - name: Set up buildx
        uses: docker/setup-buildx-action@v3
      - name: Login to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.repository_owner }}
          password: ${{ secrets.GITHUB_TOKEN }}
        if: ${{ env.PUSH == 'true' }}
      - name: Prepare
        run: |
          echo "PLATFORM_PAIR=${PLATFORM//\//-}" >> "$GITHUB_ENV"
      - name: Build
        id: bake
        uses: docker/bake-action@v6
        with:
          source: .
          targets: ${{ matrix.target }}
          # Bare repository name: each platform is pushed by digest, tags are applied by the merge job
          set: |
            *.tags=${{ env.GHCR_REPO }}
            *.platform=${{ matrix.platform }}
            *.output=type=image,push-by-digest=true,name-canonical=true,push=${{ env.PUSH }}
            *.cache-from=type=gha,scope=${{ matrix.target }}-${{ env.PLATFORM_PAIR }}
            *.cache-to=type=gha,scope=${{ matrix.target }}-${{ env.PLATFORM_PAIR }}
      - name: Export digest
        env:
          METADATA: ${{ steps.bake.outputs.metadata }}
        run: |
          digest="$(jq -r --arg target "$TARGET" '.[$target]["containerimage.digest"]' <<< "$METADATA")"
          test -n "$digest" && test "$digest" != null
          mkdir -p "$RUNNER_TEMP/digests"
          touch "$RUNNER_TEMP/digests/${digest#sha256:}"
        if: ${{ env.PUSH == 'true' }}
      - name: Upload digest
        uses: actions/upload-artifact@v4
        with:
          name: digests-${{ matrix.target }}-${{ env.PLATFORM_PAIR }}
          path: ${{ runner.temp }}/digests/*
          if-no-files-found: error
          retention-days: 1
        if: ${{ env.PUSH == 'true' }}

  merge:
    name: ${{ matrix.target }} (manifest)
    runs-on: ubuntu-latest
    needs:
      - build
    if: ${{ github.event_name == 'push' && github.ref == 'refs/heads/master' }}
    permissions:
      contents: read
      packages: write
    strategy:
      fail-fast: false
      matrix:
        target:
          {{ targets }}
    env:
      DOCKER_HUB_PUSH: ${{ (secrets.DOCKERHUB_USERNAME && secrets.DOCKERHUB_TOKEN) && 'true' || 'false' }}
      TARGET: ${{ matrix.target }}
    steps:
      - name: Checkout
        uses: actions/checkout@v5
      - name: Download digests
        uses: actions/download-artifact@v4
        with:
          path: ${{ runner.temp }}/digests
          pattern: digests-${{ matrix.target }}-*
          merge-multiple: true
      - name: Set up buildx
        uses: docker/setup-buildx-action@v3
      - name: Login to GitHub Container Registry
        uses: docker/login-action@v3
        with:
          registry: ghcr.io
          username: ${{ github.repository_owner }}
          password: ${{ secrets.GITHUB_TOKEN }}
      - name: Login to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}
        if: ${{ env.DOCKER_HUB_PUSH == 'true' }}
        continue-on-error: true
      - name: Publish to GitHub Container Registry
        run: |
          # Tags stay defined in docker-bake.hcl; only the registry and repository vary
          mapfile -t tags < <(REGISTRY="${GHCR_REPO%%/*}" REPO="${GHCR_REPO#*/}" docker buildx bake --print "$TARGET" | jq -r '.target[].tags[] | "--tag", .')
          sources=()
          for digest in "$RUNNER_TEMP"/digests/*; do
            sources+=("$GHCR_REPO@sha256:$(basename "$digest")")
          done
          docker buildx imagetools create "${tags[@]}" "${sources[@]}"
          echo "GHCR_IMAGE=${tags[1]}" >> "$GITHUB_ENV"
      - name: Copy to Docker Hub
        # A Docker Hub failure must not hold back the GHCR images
        continue-on-error: true
        run: |
          mapfile -t tags < <(REGISTRY="${DOCKER_HUB_REPO%%/*}" REPO="${DOCKER_HUB_REPO#*/}" docker buildx bake --print "$TARGET" | jq -r '.target[].tags[] | "--tag", .')
          docker buildx imagetools create "${tags[@]}" "$GHCR_IMAGE"
        if: ${{ env.DOCKER_HUB_PUSH == 'true' }}
